{
	"name": "@natlibfi/melinda-rest-api-http",
	"description": "RESTful API for Melinda",
	"author": {
		"name": "The National Library of Finland"
	},
	"keywords": [],
	"homepage": "https://github.com/natlibfi/melinda-rest-api-http",
	"bugs": {
		"url": "https://github.com/natlibfi/melinda-rest-api-http/issues"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:natlibfi/melinda-rest-api-http.git"
	},
	"license": "MIT",
	"version": "4.0.4",
	"main": "dist/index.js",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"prepare": "npm run build",
		"start": "node ./dist/index.js",
		"lint": "eslint ./src ./test",
		"lint:dev": "eslint --fix ./src ./test",
		"typecheck": "tsc -p tsconfig.test.json",
		"test": "npm run lint && npm run typecheck && npm run test:base",
		"test:base": "node --test --test-force-exit --experimental-test-module-mocks --experimental-test-coverage --test-coverage-lines=88 --test-coverage-branches=88 --test-coverage-functions=90 --test-coverage-include=src/** --test-reporter=spec './test/*.test.ts' './test/**/*.test.ts'",
		"watch:test": "cross-env DEBUG=@natlibfi/* LOG_LEVEL=debug NODE_ENV=test node --watch --test --experimental-test-module-mocks --experimental-test-coverage --test-reporter=spec './test/*.test.ts' './test/**/*.test.ts'",
		"dev": "npm run watch:test",
		"prod": "NODE_ENV=production npm run build && npm run start",
		"build": "rm -rf dist && tsc && cp src/api.json dist && cp src/api.yaml dist"
	},
	"dependencies": {
		"@natlibfi/marc-record-serializers": "^11.0.3",
		"@natlibfi/melinda-commons": "^16.0.0",
		"@natlibfi/melinda-rest-api-commons": "^5.0.7",
		"@natlibfi/passport-melinda-aleph": "^4.0.1",
		"@natlibfi/sru-client": "^7.0.1",
		"body-parser": "^2.2.2",
		"express": "^5.3.0",
		"http-status": "^2.1.0",
		"ip-range-check": "^0.2.0",
		"moment": "^2.30.1",
		"mongo-sanitize": "^1.1.0",
		"passport": "^0.7.0",
		"uuid": "^14.0.0"
	},
	"devDependencies": {
		"@natlibfi/fixugen": "^4.0.0",
		"@natlibfi/fixugen-http-server": "^3.0.0",
		"@natlibfi/fixura": "^5.0.0",
		"@natlibfi/fixura-mongo": "^4.0.2",
		"@types/body-parser": "^1.19.6",
		"@types/express": "^5.0.6",
		"@types/mongo-sanitize": "^1.0.3",
		"@types/node": "^25.9.9",
		"@types/passport": "^1.0.17",
		"@types/passport-http": "^0.3.11",
		"cross-env": "^10.1.0",
		"eslint": "^10.4.0",
		"jiti": "^2.7.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"overrides": {
		"nanoid": "^3.3.8",
		"@natlibfi/melinda-commons": "^16.0.0",
		"nodemailer": "^10.0.2"
	}
}
